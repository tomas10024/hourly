# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://hourly:hourly@localhost:5433/hourly?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Web application origin (used for CORS and for building share-link URLs)
WEB_ORIGIN="http://localhost:3000"

# Access token (JWT) signing secret. Production requires at least 32 characters:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-access-secret-pakeisti"
# Access token lifetime: 15m, 1h, 30s or seconds. Refresh tokens are opaque
# random values stored as hashes, so they need no secret.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Refresh token cookie. The defaults suit local http; when the web application
# and the API live on different domains use SameSite "none" with Secure "true".
REFRESH_COOKIE_SAMESITE="lax"
# COOKIE_SECURE defaults to true in production and false otherwise.
# COOKIE_SECURE=false

# Brute-force limits on login, registration and refresh (429 when exceeded).
# On by default; "false" is meant for load tests only.
# AUTH_RATE_LIMIT=true

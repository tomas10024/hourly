# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://hourly:hourly@localhost:5433/hourly?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Web application origin (used for CORS and for building share-link URLs)
WEB_ORIGIN="http://localhost:3000"

# JWT secrets - use random values in production, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-access-secret-pakeisti"
JWT_REFRESH_SECRET="dev-refresh-secret-pakeisti"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

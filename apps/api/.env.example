# Duomenų bazė (atitinka docker-compose.yml)
DATABASE_URL="postgresql://valandine:valandine@localhost:5432/valandine?schema=public"

# Serveris
PORT=4000
NODE_ENV=development

# Internetinės aplikacijos kilmė (CORS ir peržiūros nuorodų generavimui)
WEB_ORIGIN="http://localhost:3000"

# JWT paslaptys - gamyboje naudokite atsitiktines reikšmes,
# pvz.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-access-secret-pakeisti"
JWT_REFRESH_SECRET="dev-refresh-secret-pakeisti"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

// Valandinė - data schema.
// Hierarchy: Project -> Task -> Work session.
// Alongside the hierarchy: Proposal (drives the marketplace project lifecycle)
// and ShareLink (a capability token for a client without an account).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  SPECIALIST
  ADMIN
}

enum ProjectOrigin {
  MARKETPLACE
  DIRECT
}

enum TaskAuthoring {
  CLIENT
  SPECIALIST
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role
  bio          String?
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects    Project[]      @relation("ProjectClient")
  assignedProjects Project[]      @relation("ProjectSpecialist")
  proposals        Proposal[]
  workSessions     WorkSession[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

/// Refresh tokens: only the hash is stored and rotation is applied.
/// `familyId` makes it possible to revoke a whole token family when an
/// already revoked token is replayed.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  description   String
  origin        ProjectOrigin @default(MARKETPLACE)
  status        ProjectStatus @default(DRAFT)
  taskAuthoring TaskAuthoring @default(CLIENT)

  budgetMin  Decimal?  @db.Decimal(10, 2)
  budgetMax  Decimal?  @db.Decimal(10, 2)
  /// Default rate; an individual task may override it.
  hourlyRate Decimal?  @db.Decimal(10, 2)
  deadline   DateTime?

  /// Client of directly agreed work who has no account on the platform.
  externalClientName String?

  clientId     String? @db.Uuid
  specialistId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     User?       @relation("ProjectClient", fields: [clientId], references: [id], onDelete: SetNull)
  specialist User?       @relation("ProjectSpecialist", fields: [specialistId], references: [id], onDelete: SetNull)
  tasks      Task[]
  proposals  Proposal[]
  shareLinks ShareLink[]

  @@index([status, origin])
  @@index([clientId])
  @@index([specialistId])
  @@map("projects")
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(TODO)
  position    Int        @default(0)

  /// Overrides the project rate; null means inherited from the project.
  hourlyRate     Decimal?  @db.Decimal(10, 2)
  estimatedHours Decimal?  @db.Decimal(8, 2)
  /// When the client approved a task proposed by the specialist.
  approvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions WorkSession[]

  @@index([projectId, position])
  @@map("tasks")
}

model WorkSession {
  id           String @id @default(uuid()) @db.Uuid
  taskId       String @db.Uuid
  specialistId String @db.Uuid

  startedAt DateTime
  /// null - the session is still running. A partial unique index (see the
  /// migration) ensures a user has at most one such session at a time.
  endedAt   DateTime?
  /// Filled in when the session ends; lets totals be summed without recomputing.
  durationMinutes Int?
  comment         String?
  /// The rate in force during the session (task rate or project rate).
  appliedRate     Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  specialist User @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([specialistId, startedAt])
  @@map("work_sessions")
}

model Proposal {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @db.Uuid
  specialistId  String         @db.Uuid
  price         Decimal?       @db.Decimal(10, 2)
  hourlyRate    Decimal?       @db.Decimal(10, 2)
  estimatedDays Int?
  message       String?
  status        ProposalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specialist User    @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  /// A specialist may submit at most one proposal per project.
  /// Only one proposal can be accepted - see the partial unique index in the migration.
  @@unique([projectId, specialistId])
  @@index([specialistId, status])
  @@map("proposals")
}

/// Share link: a capability token granting read-only access to exactly one
/// project. Only the hash of the token is stored.
model ShareLink {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("share_links")
}
